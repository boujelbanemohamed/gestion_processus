// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  contributeur
  lecteur
}

enum UserStatus {
  actif
  inactif
  suspendu
}

enum EntiteType {
  direction
  departement
  service
  cellule
  division
  equipe
}

enum ProcessusStatut {
  brouillon
  en_revision
  valide
  actif
  archive
  obsolete
}

enum DocType {
  processus
  projet
  general
  procedure
  formulaire
  contrat
  client_fournisseur
  template
  tache
  licence
  autre
}

enum RefType {
  processus
  projet
  entite
  clientFournisseur
  licence
}

enum DocStatut {
  brouillon
  en_revision
  valide
  archive
}

enum LogAction {
  connexion
  deconnexion
  lecture
  creation
  modification
  suppression
  telechargement
  export
}

enum ResourceType {
  processus
  projet
  document
  entite
  utilisateur
  licence
  clientFournisseur
  contrat
}

enum PermissionResource {
  processus
  projet
  document
  entite
  clientFournisseur
}

enum PermissionType {
  lecture
  modification
  suppression
  gestion
}

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  passwordHash     String
  nom              String
  prenom           String
  role             Role        @default(contributeur)
  avatarUrl        String?
  statut           UserStatus  @default(actif)
  derniereConnexion DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations existantes
  processusProprietaire Processus[] @relation("ProcessusProprietaire")
  processusCreatedBy    Processus[] @relation("ProcessusCreatedBy")
  documentsUploaded     Document[]
  documentsValides      Document[]  @relation("DocumentValidePar")
  versionsDocuments     VersionDocument[] @relation("VersionDocumentUploadedBy")
  permissions           Permission[] @relation("PermissionUser")
  permissionsGranted    Permission[] @relation("PermissionGrantedBy")
  documentPermissions    DocumentPermission[] @relation("DocumentPermissionUser")
  journalAcces          JournalAcces[]
  entitesResponsable    Entite[]    @relation("EntiteResponsable")
  entitesMembres        UserEntite[]
  passwordResetTokens   PasswordResetToken[]
  documentComments      DocumentComment[]
  smtpConfigsUpdated    SMTPConfig[] @relation("SMTPConfigUpdatedBy")
  favorisProcessus      FavorisProcessus[]
  favorisDocuments      FavorisDocument[]

  // NOUVEAU - Relations projets gouvernance
  projetsSponsor        ProjetSponsor[]
  projetsChefProjet     ProjetChefProjet[]
  projetsCreatedBy      Projet[]    @relation("ProjetCreatedBy")
  projetsResponsable    Projet[]    @relation("ProjetResponsable")
  projetsGestionnaire   Projet[]    @relation("ProjetGestionnaire")
  projetsTechLead       ProjetTechLead[]
  projetsEquipe         ProjetEquipe[]

  @@index([email])
  contratsCreated       Contrat[]              @relation("ContratCreatedBy")
  contratPermissions    ContratPermission[]    @relation("ContratPermission")
  tachesCreees          Tache[]                @relation("TacheCreateur")
  tachesAssignees       TacheUser[]            @relation("TacheAssigneUser")
  epicsCrees            Epic[]                 @relation("EpicCreatedBy")
  tacheCommentaires     TacheCommentaire[]     @relation("TacheCommentaireUser")
  notifications         Notification[]         @relation("NotificationUser")

  licencesCreees              Licence[]              @relation("LicenceCreatedBy")
  licencePermissions        LicencePermission[]
  licenceCommentaires       LicenceCommentaire[]   @relation("LicenceCommentaireAuteur")
  licenceCommentairesAssignes LicenceCommentaire[] @relation("LicenceCommentaireAssigne")

  clientsFournisseursCrees       ClientFournisseur[]              @relation("ClientFournisseurCreatedBy")
  clientFournisseurHistorique    ClientFournisseurHistorique[]
  contratHistorique              ContratHistorique[]
  entitesCreees                  Entite[]                         @relation("EntiteCreatedBy")
}

model Entite {
  id                String      @id @default(uuid())
  nom               String
  type              EntiteType
  parentId          String?
  parent            Entite?     @relation("EntiteHierarchie", fields: [parentId], references: [id], onDelete: Cascade)
  children          Entite[]    @relation("EntiteHierarchie")
  responsableId    String?
  responsable      User?       @relation("EntiteResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  code              String      @unique
  description      String?
  createdById       String?
  createdBy         User?       @relation("EntiteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt         DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  membres           UserEntite[]
  processus         ProcessusEntite[]
  projets           ProjetEntite[]
  tachesAssignees   TacheEntite[]
  epicEntites       EpicEntite[]

  @@index([parentId])
  @@index([code])
  @@index([deletedAt])
  @@index([createdById])
}

model UserEntite {
  id                String      @id @default(uuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entiteId          String
  entite            Entite      @relation(fields: [entiteId], references: [id], onDelete: Cascade)
  createdAt         DateTime    @default(now())

  @@unique([userId, entiteId])
  @@index([userId])
  @@index([entiteId])
}

model CategorieProcessus {
  id                String      @id @default(uuid())
  nom               String
  description       String?
  couleur           String?
  icone             String?
  parentId          String?
  parent            CategorieProcessus? @relation("CategorieHierarchie", fields: [parentId], references: [id], onDelete: Cascade)
  children          CategorieProcessus[] @relation("CategorieHierarchie")
  processus         ProcessusCategorie[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([parentId])
}

model Processus {
  id                     String            @id @default(uuid())
  nom                    String
  codeProcessus          String            @unique
  description            String?
  tags                   String[]          @default([])
  statut                 ProcessusStatut   @default(brouillon)
  versionActuelle        String?
  proprietaireId         String?
  proprietaire           User?             @relation("ProcessusProprietaire", fields: [proprietaireId], references: [id], onDelete: SetNull)
  dateValidation         DateTime?
  dateProchaineRevision DateTime?
  createdById            String?
  createdBy              User?             @relation("ProcessusCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt              DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  // Relations
  entites                ProcessusEntite[]
  categories             ProcessusCategorie[]
  favoris                FavorisProcessus[]
  licenceLiens LicenceProcessus[]

  @@index([statut])
  @@index([codeProcessus])
  @@index([deletedAt])
}

model ProcessusCategorie {
  id                String            @id @default(uuid())
  processusId       String
  processus         Processus        @relation(fields: [processusId], references: [id], onDelete: Cascade)
  categorieId       String
  categorie         CategorieProcessus @relation(fields: [categorieId], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now())

  @@unique([processusId, categorieId])
  @@index([processusId])
  @@index([categorieId])
}

model ProcessusEntite {
  id                String    @id @default(uuid())
  processusId       String
  processus         Processus @relation(fields: [processusId], references: [id], onDelete: Cascade)
  entiteId          String
  entite            Entite    @relation(fields: [entiteId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())

  @@unique([processusId, entiteId])
  @@index([processusId])
  @@index([entiteId])
}

model Projet {
  id                    String          @id @default(uuid())
  nom                   String
  codeProjet            String          @unique
  description           String?
  tags                  String[]        @default([])

  // MODIFIÉ - Type étendu : interne | client | communautaire
  type                  String          @default("interne")
  nomClient             String?         // NOUVEAU - Nom du client si type = client

  // MODIFIÉ - Statut étendu : en_preparation | en_cours | termine | en_pause
  statut                String          @default("en_preparation")

  // NOUVEAU - Priorité : haute | moyenne | basse
  priorite              String          @default("moyenne")

  dateDebut             DateTime?
  dateFinPrevue         DateTime?
  dateFinReelle         DateTime?
  budgetPrevu           Decimal?        @db.Decimal(15, 2)
  budgetConsomme        Decimal?        @db.Decimal(15, 2)
  responsableId         String?
  gestionnaireId        String?
  responsable           User?           @relation("ProjetResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  gestionnaire          User?           @relation("ProjetGestionnaire", fields: [gestionnaireId], references: [id], onDelete: SetNull)

  // NOUVEAU - Contexte et description
  contexte              String?
  mission               String?
  vision                String?
  scopeInclus           String?
  scopeExclus           String?

  // NOUVEAU - Objectifs et KPIs (stockés en JSON)
  objectifsStrategiques String?         // JSON: string[]
  objectifsOperationnels String?        // JSON: string[]
  kpis                  String?         // JSON: string[]

  // NOUVEAU - Parties prenantes (JSON: [{type: string, nom: string}])
  partiesPrenantes      String?

  createdById           String?
  createdBy             User?             @relation("ProjetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relations existantes
  entites               ProjetEntite[]

  // NOUVEAU - Relations gouvernance
  sponsors              ProjetSponsor[]
  chefsProjet           ProjetChefProjet[]
  techLeads             ProjetTechLead[]
  equipe                ProjetEquipe[]
  clientsFournisseurs   ClientFournisseurProjet[]

  @@index([statut])
  @@index([codeProjet])
  @@index([deletedAt])
  contrats              ContratProjet[]
  taches                Tache[]
  epics                 Epic[]
}

model ProjetEntite {
  id                String    @id @default(uuid())
  projetId          String
  projet            Projet    @relation(fields: [projetId], references: [id], onDelete: Cascade)
  entiteId          String
  entite            Entite    @relation(fields: [entiteId], references: [id], onDelete: Cascade)
  roleEntite        String?
  createdAt         DateTime  @default(now())

  @@unique([projetId, entiteId])
  @@index([projetId])
  @@index([entiteId])
}

// NOUVEAU - Tables de gouvernance du projet
model ProjetSponsor {
  id        String   @id @default(uuid())
  projetId  String
  projet    Projet   @relation(fields: [projetId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projetId, userId])
  @@index([projetId])
  @@index([userId])
}

model ProjetChefProjet {
  id        String   @id @default(uuid())
  projetId  String
  projet    Projet   @relation(fields: [projetId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projetId, userId])
  @@index([projetId])
  @@index([userId])
}

model ProjetTechLead {
  id        String   @id @default(uuid())
  projetId  String
  projet    Projet   @relation(fields: [projetId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projetId, userId])
  @@index([projetId])
  @@index([userId])
}

model ProjetEquipe {
  id        String   @id @default(uuid())
  projetId  String
  projet    Projet   @relation(fields: [projetId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projetId, userId])
  @@index([projetId])
  @@index([userId])
}

model Document {
  id                  String      @id @default(uuid())
  nom                 String
  typeDocument        DocType
  referenceId         String?
  referenceType       RefType?
  version             String?
  versionMajeure      Int?        @default(1)
  versionMineure      Int?        @default(0)
  fichierUrl          String
  fichierNomOriginal  String
  fichierTaille       Int
  fichierType         String
  description         String?
  statut              DocStatut   @default(brouillon)
  estConfidentiel     Boolean     @default(false)
  uploadedById        String
  uploadedBy          User        @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  valideById          String?
  valideBy            User?       @relation("DocumentValidePar", fields: [valideById], references: [id], onDelete: SetNull)
  dateValidation      DateTime?
  tags                Json?
  texteOcr            String?  @db.Text
  ocrTraite           Boolean  @default(false)
  ocrDate             DateTime?
  deletedAt           DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Relations
  versions            VersionDocument[]
  permissionsUtilisateurs DocumentPermission[]
  comments            DocumentComment[]
  favoris             FavorisDocument[]
  tacheDocuments      TacheDocument[]    @relation("DocumentTache")
  epicDocuments       EpicDocument[]

  @@index([referenceId, referenceType])
  @@index([typeDocument])
  @@index([statut])
  @@index([deletedAt])
  contrats              ContratDocument[]      @relation("DocumentContrat")
  licenceDocuments      LicenceDocument[]
}

model VersionDocument {
  id                String      @id @default(uuid())
  documentId        String
  document          Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version           String
  fichierUrl        String
  commentaireVersion String?
  uploadedById      String
  uploadedBy        User        @relation("VersionDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt         DateTime    @default(now())

  @@index([documentId])
}

model DocumentPermission {
  id                String      @id @default(uuid())
  documentId        String
  document          Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId            String
  user              User        @relation("DocumentPermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime    @default(now())

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

model DocumentComment {
  id                String   @id @default(uuid())
  documentId        String
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contenu           String
  pieceJointeNom    String?
  pieceJointePath   String?
  pieceJointeType   String?
  pieceJointeTaille Int?
  createdAt         DateTime @default(now())

  @@index([documentId])
  @@index([userId])
}

model JournalAcces {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  action            LogAction
  ressourceType     ResourceType
  ressourceId       String?
  ressourceNom      String?
  details           Json?
  ipAddress         String?
  userAgent         String?
  timestamp         DateTime      @default(now())

  @@index([userId])
  @@index([ressourceType, ressourceId])
  @@index([timestamp])
  @@index([action])
}

model Permission {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation("PermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  ressourceType     PermissionResource
  ressourceId      String
  permission       PermissionType
  grantedById      String
  grantedBy        User              @relation("PermissionGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  createdAt        DateTime          @default(now())

  @@unique([userId, ressourceType, ressourceId, permission])
  @@index([userId])
  @@index([ressourceType, ressourceId])
}

model SMTPConfig {
  id                String      @id @default(uuid())
  host              String
  port              Int
  secure            Boolean     @default(false)
  user              String
  password          String
  fromEmail         String
  fromName          String?
  isActive          Boolean     @default(false)
  lastTestResult    Json?
  lastTestAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  updatedById       String?
  updatedBy         User?       @relation("SMTPConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model FavorisProcessus {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  processusId String
  processus   Processus @relation(fields: [processusId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, processusId])
  @@index([userId])
  @@index([processusId])
}

model FavorisDocument {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, documentId])
  @@index([userId])
  @@index([documentId])
}

model TypeSociete {
  id          String   @id @default(uuid())
  nom         String   @unique
  description String?
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clientsFournisseurs ClientFournisseur[]
}

model ClientFournisseur {
  id               String   @id @default(uuid())
  type             String   // 'client' | 'fournisseur'
  nom              String
  typeSocieteId    String?
  typeSociete      TypeSociete? @relation(fields: [typeSocieteId], references: [id], onDelete: SetNull)
  matriculeFiscale String?
  adresse          String?
  pays             String?
  createdById      String?
  createdBy        User?    @relation("ClientFournisseurCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  representants    RepresentantLegal[]
  projets          ClientFournisseurProjet[]
  licenceLiens     LicenceClientFournisseur[]
  historique       ClientFournisseurHistorique[]
}

model ClientFournisseurHistorique {
  id                  String            @id @default(uuid())
  clientFournisseurId String
  clientFournisseur   ClientFournisseur @relation(fields: [clientFournisseurId], references: [id], onDelete: Cascade)
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  typeEvenement       String
  libelle             String?
  details             Json?
  createdAt           DateTime          @default(now())

  @@index([clientFournisseurId, createdAt])
  @@index([userId])
}

model RepresentantLegal {
  id                  String   @id @default(uuid())
  clientFournisseurId String
  clientFournisseur   ClientFournisseur @relation(fields: [clientFournisseurId], references: [id], onDelete: Cascade)
  nom                 String
  prenom              String
  fonction            String?
  statut              String   @default("en_exercice") // 'en_exercice' | 'fin_exercice'
  dateDebut           DateTime?
  dateFin             DateTime?
  createdAt           DateTime @default(now())
}

model ClientFournisseurProjet {
  id                  String   @id @default(uuid())
  clientFournisseurId String
  clientFournisseur   ClientFournisseur @relation(fields: [clientFournisseurId], references: [id], onDelete: Cascade)
  projetId            String
  projet              Projet   @relation(fields: [projetId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  @@unique([clientFournisseurId, projetId])
}

model Contrat {
  id                String   @id @default(uuid())
  nom               String
  dateSignature     DateTime?
  dateEnregistrement DateTime?
  dateExpiration    DateTime?
  statut            String   @default("actif") // actif | expire | resilie | suspendu
  tags              String?  // JSON array
  createdById       String
  createdBy         User     @relation("ContratCreatedBy", fields: [createdById], references: [id])
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  partiesPrenantes  ContratPartiePrenante[]
  projets           ContratProjet[]
  documents         ContratDocument[]
  permissions       ContratPermission[]
  licenceLiens      LicenceContrat[]
  historique        ContratHistorique[]
}

model ContratHistorique {
  id            String   @id @default(uuid())
  contratId   String
  contrat     Contrat  @relation(fields: [contratId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  typeEvenement String
  libelle     String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([contratId, createdAt])
  @@index([userId])
}

model ContratPartiePrenante {
  id                  String   @id @default(uuid())
  contratId           String
  contrat             Contrat  @relation(fields: [contratId], references: [id], onDelete: Cascade)
  nom                 String   // saisie manuelle OU nom du CF
  clientFournisseurId String?  // optionnel si sélectionné depuis la liste
  createdAt           DateTime @default(now())
}

model ContratProjet {
  id        String   @id @default(uuid())
  contratId String
  contrat   Contrat  @relation(fields: [contratId], references: [id], onDelete: Cascade)
  projetId  String
  projet    Projet   @relation(fields: [projetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([contratId, projetId])
}

model ContratDocument {
  id         String   @id @default(uuid())
  contratId  String
  contrat    Contrat  @relation(fields: [contratId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation("DocumentContrat", fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@unique([contratId, documentId])
}

model ContratPermission {
  id        String   @id @default(uuid())
  contratId String
  contrat   Contrat  @relation(fields: [contratId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ContratPermission", fields: [userId], references: [id], onDelete: Cascade)
  niveau    String   // lecture | modification | suppression
  createdAt DateTime @default(now())
  @@unique([contratId, userId])
}

// ── TACHES ────────────────────────────────────────────────────────────────────

enum TacheStatut {
  cree
  a_faire
  en_cours
  en_attente
  bloque
  termine
  archive
}

enum LiaisonType {
  concatenation
  simple
}

/// Epic agile (regroupe des user stories et des tâches via les stories)
model Epic {
  id          String   @id @default(uuid())
  nom         String
  description String?
  projetId    String
  projet      Projet   @relation(fields: [projetId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?    @relation("EpicCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userStories      UserStory[]
  documents        EpicDocument[]
  assignesEntites  EpicEntite[]

  @@index([projetId])
}

model EpicEntite {
  id        String   @id @default(uuid())
  epicId    String
  epic      Epic     @relation(fields: [epicId], references: [id], onDelete: Cascade)
  entiteId  String
  entite    Entite   @relation(fields: [entiteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([epicId, entiteId])
  @@index([epicId])
  @@index([entiteId])
}

/// User story : epicId optionnel tant qu’elle n’est pas rattachée à un epic
model UserStory {
  id          String   @id @default(uuid())
  description String
  epicId      String?
  epic        Epic?    @relation(fields: [epicId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  taches Tache[]

  @@index([epicId])
}

model EpicDocument {
  id         String   @id @default(uuid())
  epicId     String
  epic       Epic     @relation(fields: [epicId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([epicId, documentId])
  @@index([documentId])
}

model Tache {
  id                  String        @id @default(uuid())
  nom                 String
  statut              TacheStatut   @default(cree)
  dateDebut           DateTime?
  dateFinApprox       DateTime?
  description         String?
  scenarioExecution   String?
  critereAcceptation  String?
  projetId            String?
  projet              Projet?       @relation(fields: [projetId], references: [id], onDelete: SetNull)
  userStoryId         String?
  userStory           UserStory?    @relation(fields: [userStoryId], references: [id], onDelete: SetNull)
  createurId          String?
  createur            User?         @relation("TacheCreateur", fields: [createurId], references: [id], onDelete: SetNull)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  assignesUtilisateurs TacheUser[]
  assignesEntites      TacheEntite[]
  liaisons             TacheLiaison[] @relation("TacheLiaisonSource")
  liaisonsVersMoi      TacheLiaison[] @relation("TacheLiaisonCible")
  commentaires         TacheCommentaire[]
  documents            TacheDocument[]

  @@index([statut])
  @@index([projetId])
  @@index([createurId])
  @@index([userStoryId])
}

model TacheUser {
  id        String   @id @default(uuid())
  tacheId   String
  tache     Tache    @relation(fields: [tacheId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("TacheAssigneUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tacheId, userId])
  @@index([tacheId])
  @@index([userId])
}

model TacheEntite {
  id        String   @id @default(uuid())
  tacheId   String
  tache     Tache    @relation(fields: [tacheId], references: [id], onDelete: Cascade)
  entiteId  String
  entite    Entite   @relation(fields: [entiteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tacheId, entiteId])
  @@index([tacheId])
  @@index([entiteId])
}

model TacheLiaison {
  id          String      @id @default(uuid())
  tacheId     String
  tache       Tache       @relation("TacheLiaisonSource", fields: [tacheId], references: [id], onDelete: Cascade)
  tacheLieeId String
  tacheLiee   Tache       @relation("TacheLiaisonCible", fields: [tacheLieeId], references: [id], onDelete: Cascade)
  type        LiaisonType @default(simple)
  createdAt   DateTime    @default(now())

  @@unique([tacheId, tacheLieeId])
  @@index([tacheId])
}

model TacheCommentaire {
  id              String   @id @default(uuid())
  tacheId         String
  tache           Tache    @relation(fields: [tacheId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation("TacheCommentaireUser", fields: [userId], references: [id], onDelete: Cascade)
  contenu         String
  pieceJointeNom  String?
  pieceJointePath String?
  pieceJointeType String?
  createdAt       DateTime @default(now())

  @@index([tacheId])
  @@index([userId])
}

// ── NOTIFICATIONS ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("mention")
  titre     String
  contenu   String
  lienType  String?
  lienId    String?
  lue       Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([lue])
}

// ── TACHE DOCUMENTS ───────────────────────────────────────────────────────────

model TacheDocument {
  id         String   @id @default(uuid())
  tacheId    String
  tache      Tache    @relation(fields: [tacheId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation("DocumentTache", fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([tacheId, documentId])
  @@index([tacheId])
  @@index([documentId])
}

// ── TYPE LICENCE ─────────────────────────────────────────────────────────────
model TypeLicence {
  id        String   @id @default(uuid())
  nom       String   @unique
  createdAt DateTime @default(now())
}

// ── DEVISES (licences, coûts) ────────────────────────────────────────────────
model Devise {
  id        String   @id @default(uuid())
  code      String   @unique // ex. TND, EUR — valeur enregistrée sur la licence
  libelle   String? // ex. Dinar tunisien
  createdAt DateTime @default(now())
}

// ── LICENCES ──────────────────────────────────────────────────────────────────

model Licence {
  id          String    @id @default(uuid())
  nom         String
  reference   String    @unique
  typeLicence String
  statut      String    @default("active")
  cout        Decimal?  @db.Decimal(15, 2)
  devise      String?
  nombreSieges Int?
  dateDebut   DateTime?
  dateFin     DateTime?
  description String?

  createdById String?
  createdBy   User?    @relation("LicenceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contratsLies              LicenceContrat[]
  processusLies             LicenceProcessus[]
  clientsFournisseursLies   LicenceClientFournisseur[]
  permissions               LicencePermission[]
  documents                 LicenceDocument[]
  commentaires              LicenceCommentaire[]
  notifications             LicenceNotification[]

  @@index([statut])
  @@index([deletedAt])
  @@index([createdById])
}

/// Liaison N-N licence ↔ contrat
model LicenceContrat {
  licenceId String
  contratId String
  licence   Licence @relation(fields: [licenceId], references: [id], onDelete: Cascade)
  contrat   Contrat @relation(fields: [contratId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([licenceId, contratId])
  @@index([contratId])
}

/// Liaison N-N licence ↔ processus
model LicenceProcessus {
  licenceId   String
  processusId String
  licence     Licence   @relation(fields: [licenceId], references: [id], onDelete: Cascade)
  processus   Processus @relation(fields: [processusId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([licenceId, processusId])
  @@index([processusId])
}

/// Liaison N-N licence ↔ client/fournisseur
model LicenceClientFournisseur {
  licenceId           String
  clientFournisseurId String
  licence             Licence           @relation(fields: [licenceId], references: [id], onDelete: Cascade)
  clientFournisseur   ClientFournisseur @relation(fields: [clientFournisseurId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())

  @@id([licenceId, clientFournisseurId])
  @@index([clientFournisseurId])
}

model LicencePermission {
  id        String   @id @default(uuid())
  licenceId String
  licence   Licence  @relation(fields: [licenceId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  niveau    String
  createdAt DateTime @default(now())

  @@unique([licenceId, userId])
  @@index([licenceId])
  @@index([userId])
}

model LicenceDocument {
  id         String   @id @default(uuid())
  licenceId  String
  licence    Licence  @relation(fields: [licenceId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([licenceId, documentId])
  @@index([licenceId])
  @@index([documentId])
}

model LicenceCommentaire {
  id          String   @id @default(uuid())
  licenceId   String
  licence     Licence  @relation(fields: [licenceId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("LicenceCommentaireAuteur", fields: [userId], references: [id], onDelete: Cascade)
  contenu     String
  assigneAId  String?
  assigneUser User?    @relation("LicenceCommentaireAssigne", fields: [assigneAId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([licenceId])
}

model LicenceNotification {
  id              String   @id @default(uuid())
  licenceId       String
  licence         Licence  @relation(fields: [licenceId], references: [id], onDelete: Cascade)
  joursAvant      Int
  active          Boolean  @default(true)
  destinataireIds String[] @default([])
  createdAt       DateTime @default(now())

  @@index([licenceId])
}
