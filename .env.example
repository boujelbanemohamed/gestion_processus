# Variables d'environnement pour Docker Compose
# Copiez ce fichier en .env et modifiez les valeurs

# Accès depuis le navigateur (défaut docker-compose : serveur hub 172.17.5.198)
# Développement sur la même machine que Docker : mettre localhost ci-dessous
# Reverse proxy HTTPS / WAF : adapter (ex. https://pmo.monetiquetunisie.com/api/v1)
VITE_API_URL=http://172.17.5.198:4000/api/v1
# VITE_API_URL=https://pmo.monetiquetunisie.com/api/v1     # WAF / production
FRONTEND_URL=http://172.17.5.198:5173
# FRONTEND_URL=https://pmo.monetiquetunisie.com              # WAF / production

# Secrets JWT - Application 1
JWT_SECRET_APP1=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET_APP1=your-super-secret-refresh-key-change-in-production

# Secrets JWT - Application 2
JWT_SECRET_APP2=your-super-secret-jwt-key-app2
JWT_REFRESH_SECRET_APP2=your-super-secret-refresh-key-app2

# Mots de passe PostgreSQL (optionnel, par défaut dans docker-compose.yml)
POSTGRES_PASSWORD_APP1=postgres
POSTGRES_PASSWORD_APP2=postgres
