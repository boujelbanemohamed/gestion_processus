<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SIM Manager</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Sora:wght@300;400;600;700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#0a0e1a;--surface:#111827;--surface2:#1a2235;--border:#1e2d45;--accent:#00d4ff;--text:#e2e8f0;--text-muted:#64748b;--ooredoo:#e4002b;--tunisie:#006bb6;--orange:#ff7900;--success:#22c55e;--danger:#ef4444;--warn:#f59e0b;}
*{margin:0;padding:0;box-sizing:border-box;}
body{background:var(--bg);color:var(--text);font-family:'Sora',sans-serif;min-height:100vh;}
body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(0,212,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(0,212,255,.03) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;}
.app{position:relative;z-index:1;display:none;}

/* LOGIN */
.login-screen{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:20px;}
.login-card{background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:48px 40px;width:100%;max-width:420px;box-shadow:0 25px 60px rgba(0,0,0,.5);}
.login-logo{display:flex;align-items:center;gap:12px;margin-bottom:32px;justify-content:center;}
.login-logo-icon{width:48px;height:48px;border-radius:14px;background:linear-gradient(135deg,var(--accent),#006bb6);display:flex;align-items:center;justify-content:center;font-size:22px;}
.login-logo h1{font-size:1.5rem;font-weight:800;letter-spacing:-.03em;}
.login-error{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);border-radius:8px;padding:10px 14px;font-size:.83rem;color:var(--danger);margin-bottom:16px;display:none;}

/* HEADER */
header{padding:14px 28px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;background:rgba(10,14,26,.95);backdrop-filter:blur(10px);position:sticky;top:0;z-index:100;gap:12px;}
.logo{display:flex;align-items:center;gap:10px;flex-shrink:0;}
.logo-icon{width:34px;height:34px;border-radius:9px;background:linear-gradient(135deg,var(--accent),#006bb6);display:flex;align-items:center;justify-content:center;font-size:16px;}
.logo h1{font-size:1rem;font-weight:800;letter-spacing:-.02em;}
.logo span{color:var(--accent);font-weight:300;}
nav{display:flex;gap:3px;flex-wrap:wrap;}
.nav-btn{padding:7px 14px;border-radius:8px;border:none;background:transparent;color:var(--text-muted);font-family:'Sora',sans-serif;font-size:.81rem;font-weight:600;cursor:pointer;transition:all .2s;}
.nav-btn:hover{color:var(--text);background:var(--surface);}
.nav-btn.active{color:var(--accent);background:rgba(0,212,255,.1);}
.nav-btn[data-perm]{display:none;}
.header-right{display:flex;align-items:center;gap:8px;flex-shrink:0;}
.user-chip{display:flex;align-items:center;gap:7px;padding:5px 12px;background:var(--surface2);border:1px solid var(--border);border-radius:20px;font-size:.77rem;}
.user-role{font-size:.67rem;padding:2px 7px;border-radius:10px;font-weight:700;}
.role-admin{background:rgba(124,58,237,.2);color:#a78bfa;border:1px solid rgba(124,58,237,.3);}
.role-stock{background:rgba(0,212,255,.15);color:var(--accent);border:1px solid rgba(0,212,255,.25);}
.role-livraison{background:rgba(245,158,11,.15);color:var(--warn);border:1px solid rgba(245,158,11,.25);}
.role-consultation{background:rgba(100,116,139,.15);color:#94a3b8;border:1px solid rgba(100,116,139,.25);}
.db-status{display:flex;align-items:center;gap:5px;font-size:.72rem;font-weight:600;padding:5px 11px;border-radius:20px;border:1px solid var(--border);color:var(--text-muted);}
.db-dot{width:6px;height:6px;border-radius:50%;background:var(--text-muted);}
.db-status.connected{color:var(--success);border-color:rgba(34,197,94,.3);}
.db-status.connected .db-dot{background:var(--success);box-shadow:0 0 6px var(--success);}
.btn-logout{background:rgba(239,68,68,.08);color:#ef4444;border:1px solid rgba(239,68,68,.2);padding:5px 12px;border-radius:8px;font-size:.77rem;font-weight:700;cursor:pointer;font-family:'Sora',sans-serif;transition:all .2s;}
.btn-logout:hover{background:rgba(239,68,68,.18);}

/* SECTIONS */
.section{display:none;padding:28px 32px;max-width:1400px;margin:0 auto;}
.section.active{display:block;animation:fadeIn .3s ease;}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.section-title{font-size:1.65rem;font-weight:800;letter-spacing:-.04em;margin-bottom:4px;}
.section-subtitle{color:var(--text-muted);font-size:.86rem;margin-bottom:24px;}

/* CARD */
.card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:22px;}
.card-title{font-weight:700;font-size:.92rem;margin-bottom:16px;display:flex;align-items:center;gap:8px;}

/* STATS */
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:12px;margin-bottom:24px;}
.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px;position:relative;overflow:hidden;}
.stat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--op-color,var(--accent));}
.stat-label{font-size:.69rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--text-muted);margin-bottom:7px;}
.stat-value{font-size:1.85rem;font-weight:800;font-family:'Space Mono',monospace;color:var(--op-color,var(--accent));}
.stat-sub{font-size:.7rem;color:var(--text-muted);margin-top:3px;}

/* FORM */
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.form-group{display:flex;flex-direction:column;gap:5px;}
.form-group.full{grid-column:1/-1;}
label{font-size:.72rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text-muted);}
input,select,textarea{background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 13px;color:var(--text);font-family:'Sora',sans-serif;font-size:.875rem;transition:border-color .2s;outline:none;}
input:focus,select:focus,textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(0,212,255,.1);}
select option{background:var(--surface);}
textarea{resize:vertical;min-height:80px;}
.hint{font-size:.7rem;color:var(--text-muted);margin-top:2px;}

/* BUTTONS */
.btn{padding:10px 18px;border-radius:10px;border:none;font-family:'Sora',sans-serif;font-size:.865rem;font-weight:700;cursor:pointer;transition:all .2s;display:inline-flex;align-items:center;gap:7px;}
.btn:disabled{opacity:.4;cursor:not-allowed;}
.btn-primary{background:linear-gradient(135deg,var(--accent),#0099cc);color:#000;box-shadow:0 4px 15px rgba(0,212,255,.3);}
.btn-primary:hover:not(:disabled){transform:translateY(-1px);box-shadow:0 6px 20px rgba(0,212,255,.4);}
.btn-secondary{background:var(--surface2);color:var(--text);border:1px solid var(--border);}
.btn-secondary:hover{border-color:var(--accent);color:var(--accent);}
.btn-danger{background:rgba(239,68,68,.12);color:#ef4444;border:1px solid rgba(239,68,68,.25);}
.btn-danger:hover{background:rgba(239,68,68,.22);}
.btn-success{background:rgba(34,197,94,.12);color:#22c55e;border:1px solid rgba(34,197,94,.25);}
.btn-success:hover{background:rgba(34,197,94,.22);}
.btn-warn{background:rgba(245,158,11,.12);color:var(--warn);border:1px solid rgba(245,158,11,.25);}
.btn-warn:hover{background:rgba(245,158,11,.22);}
.btn-sm{padding:5px 11px;font-size:.75rem;}

/* TABLE */
.table-wrap{overflow-x:auto;}
table{width:100%;border-collapse:collapse;}
th{text-align:left;padding:11px 14px;font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--text-muted);border-bottom:1px solid var(--border);}
td{padding:12px 14px;font-size:.865rem;border-bottom:1px solid rgba(30,45,69,.5);}
tr:hover td{background:rgba(255,255,255,.02);}
.iccid{font-family:'Space Mono',monospace;font-size:.76rem;color:var(--accent);letter-spacing:.04em;}

/* BADGES */
.op-badge{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:20px;font-size:.7rem;font-weight:700;}
.op-badge.ooredoo{background:rgba(228,0,43,.12);color:var(--ooredoo);border:1px solid rgba(228,0,43,.25);}
.op-badge.tunisie{background:rgba(0,107,182,.12);color:var(--tunisie);border:1px solid rgba(0,107,182,.25);}
.op-badge.orange{background:rgba(255,121,0,.12);color:var(--orange);border:1px solid rgba(255,121,0,.25);}
.op-dot{width:5px;height:5px;border-radius:50%;background:currentColor;}
.status{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:20px;font-size:.7rem;font-weight:700;}
.status.disponible{background:rgba(34,197,94,.1);color:var(--success);border:1px solid rgba(34,197,94,.22);}
.status.livre{background:rgba(100,116,139,.1);color:#94a3b8;border:1px solid rgba(100,116,139,.22);}
.active-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:20px;font-size:.7rem;font-weight:700;}
.active-badge.on{background:rgba(34,197,94,.1);color:var(--success);border:1px solid rgba(34,197,94,.22);}
.active-badge.off{background:rgba(239,68,68,.1);color:var(--danger);border:1px solid rgba(239,68,68,.22);}

/* CHIPS */
.chip-selector{display:flex;flex-wrap:wrap;gap:6px;max-height:200px;overflow-y:auto;padding:10px;background:var(--bg);border:1px solid var(--border);border-radius:10px;}
.chip-item{display:flex;align-items:center;gap:5px;padding:5px 11px;background:var(--surface2);border:1px solid var(--border);border-radius:20px;cursor:pointer;transition:all .18s;font-size:.71rem;font-family:'Space Mono',monospace;}
.chip-item:hover{border-color:var(--accent);}
.chip-item.selected{background:rgba(0,212,255,.1);border-color:var(--accent);color:var(--accent);}
.chip-check{opacity:0;font-size:.68rem;}
.chip-item.selected .chip-check{opacity:1;}

/* TABS */
.tabs{display:flex;gap:4px;margin-bottom:16px;flex-wrap:wrap;}
.tab-btn{padding:6px 15px;border-radius:8px;border:1px solid var(--border);background:transparent;color:var(--text-muted);font-family:'Sora',sans-serif;font-size:.78rem;font-weight:600;cursor:pointer;transition:all .2s;}
.tab-btn.active{background:var(--surface2);color:var(--text);border-color:var(--accent);}

/* MODAL */
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:1000;align-items:center;justify-content:center;padding:20px;}
.modal.open{display:flex;animation:fadeIn .2s;}
.modal-wrap{background:var(--surface);border:1px solid var(--border);border-radius:16px;width:100%;max-width:500px;padding:26px;position:relative;max-height:90vh;overflow-y:auto;}
.modal-title{font-size:1.05rem;font-weight:700;margin-bottom:18px;}
.modal-close{position:absolute;top:14px;right:14px;background:var(--surface2);border:none;border-radius:8px;width:30px;height:30px;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;color:var(--text-muted);}

/* FICHE CLIENT */
.fiche-livraison{background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:12px 14px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;}
.fiche-livraison-ref{font-family:'Space Mono',monospace;font-size:.78rem;color:var(--accent);}
.fiche-livraison-info{font-size:.8rem;color:var(--text-muted);}

/* BORDEREAU */
.bdr-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.88);z-index:1000;align-items:center;justify-content:center;padding:20px;}
.bdr-modal.open{display:flex;animation:fadeIn .2s;}
.bdr-wrap{background:#fff;border-radius:16px;width:100%;max-width:730px;max-height:92vh;overflow-y:auto;position:relative;color:#111;}
.bdr-close{position:absolute;top:12px;right:12px;background:#f1f5f9;border:none;border-radius:8px;width:30px;height:30px;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;color:#333;z-index:10;}
.bdr{padding:34px;font-family:Arial,sans-serif;color:#111;}
.bdr-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:22px;padding-bottom:15px;border-bottom:3px solid #111;}
.bdr-title{font-size:1.4rem;font-weight:900;letter-spacing:-.02em;}
.bdr-subtitle{font-size:.79rem;color:#555;margin-top:3px;}
.bdr-ref{text-align:right;font-size:.75rem;color:#555;}
.bdr-ref strong{display:block;font-size:.93rem;color:#111;font-family:monospace;}
.bdr-op{padding:8px 13px;border-radius:7px;font-weight:700;font-size:.8rem;margin-bottom:18px;display:flex;align-items:center;gap:8px;}
.bdr-info{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:18px;}
.bdr-info-label{font-size:.66rem;text-transform:uppercase;letter-spacing:.08em;color:#666;font-weight:700;margin-bottom:2px;}
.bdr-info-value{font-size:.89rem;font-weight:600;}
.bdr-table{width:100%;border-collapse:collapse;margin-bottom:22px;font-size:.78rem;}
.bdr-table th{background:#111;color:#fff;padding:8px 11px;text-align:left;font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;}
.bdr-table td{padding:8px 11px;border-bottom:1px solid #e2e8f0;font-family:monospace;}
.bdr-table tr:nth-child(even) td{background:#f8fafc;}
.bdr-summary{display:flex;justify-content:flex-end;margin-bottom:22px;}
.bdr-summary-box{background:#f1f5f9;border-radius:8px;padding:11px 18px;text-align:center;}
.bdr-summary-label{font-size:.67rem;text-transform:uppercase;letter-spacing:.08em;color:#555;font-weight:700;}
.bdr-summary-value{font-size:1.85rem;font-weight:900;font-family:monospace;}
.bdr-sigs{display:grid;grid-template-columns:1fr 1fr;gap:36px;padding-top:14px;border-top:1px solid #e2e8f0;}
.sig-label{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin-bottom:48px;}
.sig-line{border-bottom:2px solid #111;}
.bdr-actions{display:flex;gap:10px;padding:14px 34px;border-top:1px solid #e2e8f0;background:#f8fafc;border-radius:0 0 16px 16px;}
.btn-print-bdr{padding:9px 18px;background:#111;color:#fff;border:none;border-radius:8px;font-weight:700;cursor:pointer;font-size:.865rem;display:flex;align-items:center;gap:7px;}
.btn-print-bdr:hover{background:#333;}
.btn-close-bdr{padding:9px 18px;background:transparent;color:#555;border:1px solid #ddd;border-radius:8px;font-weight:600;cursor:pointer;font-size:.865rem;}

/* CONFIG TABS */
.config-tabs{display:flex;gap:4px;margin-bottom:24px;border-bottom:1px solid var(--border);padding-bottom:0;}
.config-tab{padding:10px 20px;border:none;background:transparent;color:var(--text-muted);font-family:'Sora',sans-serif;font-size:.86rem;font-weight:600;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px;transition:all .2s;}
.config-tab:hover{color:var(--text);}
.config-tab.active{color:var(--accent);border-bottom-color:var(--accent);}
.config-panel{display:none;}
.config-panel.active{display:block;animation:fadeIn .2s;}

/* EMPTY / LOADER */
.empty-state{text-align:center;padding:44px 20px;color:var(--text-muted);}
.empty-state-icon{font-size:2.5rem;margin-bottom:8px;}
.empty-state h3{font-size:.92rem;font-weight:600;margin-bottom:4px;color:var(--text);}
.empty-state p{font-size:.8rem;}
.loader{display:inline-block;width:15px;height:15px;border:2px solid rgba(0,212,255,.3);border-top-color:var(--accent);border-radius:50%;animation:spin .7s linear infinite;}
@keyframes spin{to{transform:rotate(360deg)}}

/* TOAST */
.toast{position:fixed;bottom:18px;right:18px;padding:11px 17px;background:var(--surface);border:1px solid var(--border);border-radius:12px;font-size:.865rem;font-weight:600;z-index:9999;transform:translateY(100px);opacity:0;transition:all .3s;display:flex;align-items:center;gap:8px;max-width:330px;}
.toast.show{transform:translateY(0);opacity:1;}
.toast.success{border-color:#22c55e44;color:var(--success);}
.toast.error{border-color:#ef444444;color:var(--danger);}
.toast.info{border-color:#00d4ff44;color:var(--accent);}

/* UTILS */
.flex{display:flex;}.gap-2{gap:8px;}.gap-3{gap:12px;}
.mb-4{margin-bottom:16px;}.mb-6{margin-bottom:22px;}.mt-4{margin-top:16px;}
.justify-between{justify-content:space-between;}.items-center{align-items:center;}
.flex-wrap{flex-wrap:wrap;}.text-muted{color:var(--text-muted);font-size:.81rem;}

@media print{
  body *{display:none!important;}
  .bdr-modal,.bdr-modal *,.bdr-wrap,.bdr-wrap *,.bdr,.bdr *{display:block!important;}
  .bdr-modal{position:static!important;background:white!important;}
  .bdr-wrap{box-shadow:none!important;max-height:none!important;}
  .bdr-actions,.bdr-close{display:none!important;}
}
</style>
</head>
<body>

<!-- LOGIN -->
<div id="login-screen" class="login-screen">
  <div class="login-card">
    <div class="login-logo">
      <div class="login-logo-icon">📡</div>
      <h1>SIM <span style="color:var(--accent);font-weight:300">Manager</span></h1>
    </div>
    <div style="font-size:1rem;font-weight:700;margin-bottom:4px;">Connexion</div>
    <div style="color:var(--text-muted);font-size:.83rem;margin-bottom:24px;">Entrez vos identifiants</div>
    <div class="login-error" id="login-error"></div>
    <div class="form-group mb-4"><label>Identifiant</label>
      <input type="text" id="login-username" placeholder="admin" autocomplete="username"></div>
    <div class="form-group mb-4"><label>Mot de passe</label>
      <input type="password" id="login-password" placeholder="••••••••" autocomplete="current-password"
        onkeydown="if(event.key==='Enter')doLogin()"></div>
    <button class="btn btn-primary" id="btn-login" onclick="doLogin()" style="width:100%;justify-content:center;margin-top:6px">
      🔐 Se connecter</button>
  </div>
</div>

<!-- APP -->
<div class="app" id="app">

<header>
  <div class="logo">
    <div class="logo-icon">📡</div>
    <h1>SIM <span>Manager</span></h1>
  </div>
  <nav id="main-nav">
    <button class="nav-btn active" onclick="showSection('dashboard',this)">📊 Tableau de bord</button>
    <button class="nav-btn" onclick="showSection('stock',this)" data-perm="stock:read">📦 Stock</button>
    <button class="nav-btn" onclick="showSection('livraison',this)" data-perm="livraison:write">🚚 Livraison</button>
    <button class="nav-btn" onclick="showSection('historique',this)" data-perm="livraison:read">📋 Historique</button>
    <button class="nav-btn" onclick="showSection('config',this)" data-perm="admin">⚙️ Configuration</button>
  </nav>
  <div class="header-right">
    <div class="db-status" id="db-status"><span class="db-dot"></span><span id="db-label">…</span></div>
    <div class="user-chip">
      <span id="user-name">—</span>
      <span class="user-role" id="user-role-badge">—</span>
    </div>
    <button class="btn-logout" onclick="logout()">⏻</button>
  </div>
</header>

<!-- DASHBOARD -->
<section class="section active" id="sec-dashboard">
  <div class="section-title">Tableau de bord</div>
  <div class="section-subtitle">Vue globale du stock SIM</div>
  <div class="stats-grid" id="stats-grid">
    <div class="stat-card" style="grid-column:1/-1;display:flex;align-items:center;gap:10px;justify-content:center;padding:30px;color:var(--text-muted)">
      <div class="loader"></div> Chargement…</div>
  </div>
  <div class="card">
    <div class="card-title">🕐 Dernières puces ajoutées</div>
    <div class="table-wrap"><table>
      <thead><tr><th>ICCID</th><th>Opérateur</th><th>Lot</th><th>Date</th><th>Statut</th></tr></thead>
      <tbody id="recent-table"></tbody>
    </table></div>
  </div>
</section>

<!-- STOCK -->
<section class="section" id="sec-stock">
  <div class="section-title">Gestion du Stock</div>
  <div class="section-subtitle">Réception et consultation des puces SIM</div>

  <div class="card mb-6" id="add-lot-card">
    <div class="card-title">➕ Ajouter un lot de puces</div>
    <div class="form-grid">
      <div class="form-group"><label>Opérateur</label>
        <select id="add-op"><option value="">-- Choisir --</option>
          <option>Ooredoo</option><option>Tunisie Telecom</option><option>Orange Telecom</option></select></div>
      <div class="form-group"><label>Nom du lot</label>
        <input type="text" id="add-lot" placeholder="ex: LOT-2025-S12"></div>
      <div class="form-group full"><label>ICCIDs <span style="text-transform:none;font-weight:400">(un par ligne)</span></label>
        <textarea id="add-iccids" style="font-family:'Space Mono',monospace;font-size:.76rem" placeholder="89216030000000000001&#10;89216030000000000002"></textarea>
        <span class="hint" id="iccid-count">0 puce(s)</span></div>
    </div>
    <div class="flex gap-3 mt-4">
      <button class="btn btn-primary" id="btn-add-lot" onclick="addLot()">💾 Enregistrer le lot</button>
      <button class="btn btn-secondary" onclick="clearAddForm()">✕ Effacer</button>
    </div>
  </div>

  <div class="flex gap-3 mb-4 flex-wrap items-center justify-between">
    <div class="tabs" id="filter-tabs">
      <button class="tab-btn active" onclick="filterStock('',this)">Tous</button>
      <button class="tab-btn" onclick="filterStock('Ooredoo',this)">Ooredoo</button>
      <button class="tab-btn" onclick="filterStock('Tunisie Telecom',this)">Tunisie Telecom</button>
      <button class="tab-btn" onclick="filterStock('Orange Telecom',this)">Orange Telecom</button>
    </div>
    <input type="text" placeholder="🔍 Rechercher ICCID…" id="search-iccid" oninput="loadStock()" style="width:230px;">
  </div>
  <div class="card"><div class="table-wrap"><table>
    <thead><tr><th>#</th><th>ICCID</th><th>Opérateur</th><th>Lot</th><th>Date entrée</th><th>Statut</th></tr></thead>
    <tbody id="stock-table"></tbody>
  </table></div></div>
</section>

<!-- LIVRAISON -->
<section class="section" id="sec-livraison">
  <div class="section-title">Nouvelle Livraison</div>
  <div class="section-subtitle">Créer un bordereau de livraison client</div>

  <div class="card mb-6">
    <div class="card-title">📋 Informations client</div>
    <div class="form-grid">
      <div class="form-group full"><label>Client</label>
        <select id="liv-client-id" onchange="onClientChange()">
          <option value="">-- Choisir un client --</option>
        </select></div>
      <div class="form-group" id="liv-adresse-group" style="display:none">
        <label>Adresse</label>
        <input type="text" id="liv-adresse-display" readonly style="opacity:.6">
      </div>
      <div class="form-group"><label>Opérateur</label>
        <select id="liv-op" onchange="loadAvailableSims()">
          <option value="">-- Choisir --</option>
          <option>Ooredoo</option><option>Tunisie Telecom</option><option>Orange Telecom</option>
        </select></div>
      <div class="form-group"><label>Date de livraison</label>
        <input type="date" id="liv-date"></div>
      <div class="form-group"><label>Référence</label>
        <input type="text" id="liv-ref" readonly style="opacity:.6;font-family:'Space Mono',monospace;font-size:.8rem"></div>
    </div>
  </div>

  <div class="card mb-6" id="sim-select-card" style="display:none">
    <div class="flex justify-between items-center mb-4 flex-wrap gap-2">
      <div class="card-title" style="margin:0">📡 Puces disponibles — <span id="op-label-sel" style="color:var(--accent)"></span></div>
      <div class="flex gap-2 items-center">
        <span class="text-muted" id="sel-count">0 sélectionnée(s)</span>
        <button class="btn btn-secondary btn-sm" onclick="selectAll()">Tout</button>
        <button class="btn btn-secondary btn-sm" onclick="deselectAll()">Aucun</button>
      </div>
    </div>
    <div class="chip-selector" id="sim-chips"></div>
  </div>

  <div class="flex gap-3">
    <button class="btn btn-primary" id="btn-gen" onclick="genererBordereau()">🖨️ Générer le bordereau</button>
    <button class="btn btn-secondary" onclick="resetLivraison()">✕ Réinitialiser</button>
  </div>
</section>

<!-- HISTORIQUE -->
<section class="section" id="sec-historique">
  <div class="section-title">Historique des Livraisons</div>
  <div class="section-subtitle">Tous les bordereaux générés</div>

  <div class="flex gap-3 mb-4 flex-wrap items-center justify-between">
    <div class="tabs" id="hist-tabs">
      <button class="tab-btn active" onclick="filterHistorique(null,this)">Tous les clients</button>
    </div>
    <input type="text" placeholder="🔍 Rechercher client / réf…" id="search-hist" oninput="loadHistorique()" style="width:230px;">
  </div>

  <div class="card"><div class="table-wrap"><table>
    <thead><tr><th>Référence</th><th>Client</th><th>Adresse</th><th>Opérateur</th><th>Qté</th><th>Date</th><th>Par</th><th>Actions</th></tr></thead>
    <tbody id="hist-table"></tbody>
  </table></div></div>
</section>

<!-- CONFIGURATION -->
<section class="section" id="sec-config">
  <div class="section-title">Configuration</div>
  <div class="section-subtitle">Gestion des clients et des utilisateurs</div>

  <div class="config-tabs">
    <button class="config-tab active" onclick="showConfigTab('clients',this)">👥 Clients</button>
    <button class="config-tab" onclick="showConfigTab('users',this)">🔐 Utilisateurs</button>
  </div>

  <!-- CLIENTS PANEL -->
  <div class="config-panel active" id="panel-clients">
    <div class="flex justify-between items-center mb-6">
      <div class="text-muted">Gérez vos clients pour les livraisons</div>
      <button class="btn btn-primary" onclick="openClientModal()">➕ Nouveau client</button>
    </div>
    <div class="card"><div class="table-wrap"><table>
      <thead><tr><th>Nom</th><th>Adresse</th><th>Statut</th><th>Livraisons</th><th>Créé par</th><th>Actions</th></tr></thead>
      <tbody id="clients-table"></tbody>
    </table></div></div>
  </div>

  <!-- USERS PANEL -->
  <div class="config-panel" id="panel-users">
    <div class="flex justify-between items-center mb-6">
      <div class="text-muted">Gérez les accès à l'application</div>
      <button class="btn btn-primary" onclick="openUserModal()">➕ Nouvel utilisateur</button>
    </div>
    <div class="card mb-4"><div class="table-wrap"><table>
      <thead><tr><th>Identifiant</th><th>Nom complet</th><th>Rôle</th><th>Statut</th><th>Dernière connexion</th><th>Actions</th></tr></thead>
      <tbody id="users-table"></tbody>
    </table></div></div>

    <div class="card">
      <div class="card-title">🔐 Tableau des permissions</div>
      <div class="table-wrap"><table>
        <thead><tr><th>Rôle</th><th>Dashboard</th><th>Stock lecture</th><th>Stock écriture</th><th>Livraisons lecture</th><th>Livraisons création</th><th>Supprimer livraison</th><th>Configuration</th></tr></thead>
        <tbody>
          <tr><td><span class="user-role role-admin">Admin</span></td><td>✅</td><td>✅</td><td>✅</td><td>✅</td><td>✅</td><td>✅</td><td>✅</td></tr>
          <tr><td><span class="user-role role-stock">Stock</span></td><td>✅</td><td>✅</td><td>✅</td><td>❌</td><td>❌</td><td>❌</td><td>❌</td></tr>
          <tr><td><span class="user-role role-livraison">Livraison</span></td><td>✅</td><td>✅</td><td>❌</td><td>✅</td><td>✅</td><td>❌</td><td>❌</td></tr>
          <tr><td><span class="user-role role-consultation">Consultation</span></td><td>✅</td><td>✅</td><td>❌</td><td>✅</td><td>❌</td><td>❌</td><td>❌</td></tr>
        </tbody>
      </table></div>
    </div>
  </div>
</section>

</div><!-- .app -->

<!-- MODAL CLIENT -->
<div class="modal" id="client-modal">
  <div class="modal-wrap">
    <button class="modal-close" onclick="closeClientModal()">✕</button>
    <div class="modal-title" id="client-modal-title">Nouveau client</div>
    <div class="form-group mb-4"><label>Nom du client *</label>
      <input type="text" id="cm-nom" placeholder="ex: Société ABC"></div>
    <div class="form-group mb-4"><label>Adresse</label>
      <textarea id="cm-adresse" rows="3" placeholder="Adresse complète…"></textarea></div>
    <div class="form-group mb-4" id="cm-active-group" style="display:none"><label>Statut</label>
      <select id="cm-active"><option value="true">Actif</option><option value="false">Désactivé</option></select></div>
    <div class="flex gap-3 mt-4">
      <button class="btn btn-primary" id="btn-save-client" onclick="saveClient()">💾 Enregistrer</button>
      <button class="btn btn-secondary" onclick="closeClientModal()">Annuler</button>
    </div>
  </div>
</div>

<!-- MODAL FICHE CLIENT -->
<div class="modal" id="fiche-modal">
  <div class="modal-wrap" style="max-width:600px">
    <button class="modal-close" onclick="document.getElementById('fiche-modal').classList.remove('open')">✕</button>
    <div class="modal-title" id="fiche-title">Fiche client</div>
    <div id="fiche-content"></div>
  </div>
</div>

<!-- MODAL USER -->
<div class="modal" id="user-modal">
  <div class="modal-wrap">
    <button class="modal-close" onclick="closeUserModal()">✕</button>
    <div class="modal-title" id="user-modal-title">Nouvel utilisateur</div>
    <div class="form-grid">
      <div class="form-group"><label>Identifiant</label>
        <input type="text" id="um-username" placeholder="ex: john.doe"></div>
      <div class="form-group"><label>Nom complet</label>
        <input type="text" id="um-fullname" placeholder="John Doe"></div>
      <div class="form-group"><label>Rôle</label>
        <select id="um-role">
          <option value="consultation">Consultation</option>
          <option value="stock">Stock</option>
          <option value="livraison">Livraison</option>
          <option value="admin">Admin</option>
        </select></div>
      <div class="form-group"><label>Mot de passe <span id="um-pass-hint" style="font-weight:400;text-transform:none;font-size:.68rem"></span></label>
        <input type="password" id="um-password" placeholder="Min. 6 caractères"></div>
      <div class="form-group full" id="um-active-group" style="display:none"><label>Statut</label>
        <select id="um-active"><option value="true">Actif</option><option value="false">Désactivé</option></select></div>
    </div>
    <div class="flex gap-3 mt-4">
      <button class="btn btn-primary" id="btn-save-user" onclick="saveUser()">💾 Enregistrer</button>
      <button class="btn btn-secondary" onclick="closeUserModal()">Annuler</button>
    </div>
  </div>
</div>

<!-- BORDEREAU -->
<div class="bdr-modal" id="bdr-modal">
  <div class="bdr-wrap">
    <button class="bdr-close" onclick="document.getElementById('bdr-modal').classList.remove('open')">✕</button>
    <div class="bdr" id="bdr-content"></div>
    <div class="bdr-actions">
      <button class="btn-print-bdr" onclick="window.print()">🖨️ Imprimer</button>
      <button class="btn-close-bdr" onclick="document.getElementById('bdr-modal').classList.remove('open')">Fermer</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
const API = '';
const OPS = {
  'Ooredoo':         { cls:'ooredoo', color:'#e4002b', emoji:'🔴' },
  'Tunisie Telecom': { cls:'tunisie', color:'#006bb6', emoji:'🔵' },
  'Orange Telecom':  { cls:'orange',  color:'#ff7900', emoji:'🟠' },
};
const ROLE_PERMS = {
  admin:        ['*'],
  stock:        ['stock:read','stock:write'],
  livraison:    ['stock:read','livraison:read','livraison:write','stats:read'],
  consultation: ['stock:read','livraison:read','stats:read'],
};

let currentUser   = null;
let currentFilter = '';
let selectedIds   = [];
let editingUserId = null;
let editingClientId = null;
let histClientFilter = null;
let allClients    = [];

// ── HELPERS ─────────────────────────────────────────
function getToken() { return localStorage.getItem('sim_token'); }
function can(perm) {
  if (!currentUser) return false;
  const p = ROLE_PERMS[currentUser.role] || [];
  return p.includes('*') || p.includes(perm);
}
async function api(path, opts = {}) {
  const token = localStorage.getItem('sim_token');
  const res = await fetch(API + path, {
    ...opts,
    headers: { 'Content-Type':'application/json', ...(token?{Authorization:`Bearer ${token}`}:{}), ...opts.headers }
  });
  if (res.status === 401) { logout(); throw new Error('Session expirée'); }
  return res;
}

// ── AUTH ────────────────────────────────────────────
async function doLogin() {
  const username = document.getElementById('login-username').value.trim();
  const password = document.getElementById('login-password').value;
  const errEl = document.getElementById('login-error');
  const btn   = document.getElementById('btn-login');
  errEl.style.display = 'none';
  if (!username || !password) { errEl.textContent='Remplissez tous les champs'; errEl.style.display='block'; return; }
  btn.disabled=true; btn.innerHTML='<div class="loader"></div> Connexion…';
  try {
    const r = await fetch('/api/auth/login', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({username,password}) });
    const d = await r.json();
    if (!r.ok) { errEl.textContent=d.error||'Erreur'; errEl.style.display='block'; return; }
    localStorage.setItem('sim_token', d.token);
    currentUser = d.user;
    initApp();
  } catch(e) { errEl.textContent='Erreur de connexion au serveur'; errEl.style.display='block'; }
  finally { btn.disabled=false; btn.innerHTML='🔐 Se connecter'; }
}

function logout() {
  localStorage.removeItem('sim_token');
  currentUser = null;
  document.getElementById('app').style.display = 'none';
  document.getElementById('login-screen').style.display = 'flex';
  document.getElementById('login-username').value = '';
  document.getElementById('login-password').value = '';
}

async function tryAutoLogin() {
  const token = getToken();
  if (!token) return false;
  try {
    const r = await api('/api/auth/me');
    if (!r.ok) return false;
    currentUser = await r.json();
    return true;
  } catch { return false; }
}

function initApp() {
  document.getElementById('login-screen').style.display = 'none';
  document.getElementById('app').style.display = 'block';
  const rb = document.getElementById('user-role-badge');
  document.getElementById('user-name').textContent = currentUser.full_name;
  const roleLabels = { admin:'Admin', stock:'Stock', livraison:'Livraison', consultation:'Lecture' };
  rb.textContent = roleLabels[currentUser.role] || currentUser.role;
  rb.className = 'user-role role-' + currentUser.role;
  document.querySelectorAll('.nav-btn[data-perm]').forEach(btn => {
    const p = btn.dataset.perm;
    btn.style.display = (p==='admin' ? currentUser.role==='admin' : can(p)) ? '' : 'none';
  });
  const addCard = document.getElementById('add-lot-card');
  if (addCard) addCard.style.display = can('stock:write') ? '' : 'none';
  checkHealth();
  loadDashboard();
  loadClients();
  setInterval(checkHealth, 15000);
}

// ── HEALTH ───────────────────────────────────────────
async function checkHealth() {
  try {
    const d = await fetch('/api/health').then(r=>r.json());
    const el = document.getElementById('db-status');
    if (d.status==='ok') { el.className='db-status connected'; document.getElementById('db-label').textContent='PostgreSQL ✓'; }
    else throw new Error();
  } catch { document.getElementById('db-status').className='db-status'; document.getElementById('db-label').textContent='DB erreur'; }
}

// ── NAV ──────────────────────────────────────────────
function showSection(id, btn) {
  document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('sec-'+id).classList.add('active');
  if (btn) btn.classList.add('active');
  if (id==='dashboard')  loadDashboard();
  if (id==='stock')      loadStock();
  if (id==='historique') loadHistorique();
  if (id==='livraison')  initLivraison();
  if (id==='config')     { loadClients(); loadUsers(); }
}

function showConfigTab(tab, btn) {
  document.querySelectorAll('.config-tab').forEach(b=>b.classList.remove('active'));
  document.querySelectorAll('.config-panel').forEach(p=>p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('panel-'+tab).classList.add('active');
}

// ── DASHBOARD ────────────────────────────────────────
async function loadDashboard() {
  try {
    const s = await api('/api/stats').then(r=>r.json());
    const grid = document.getElementById('stats-grid');
    let html = `
      <div class="stat-card" style="--op-color:var(--accent)">
        <div class="stat-label">Total stock</div>
        <div class="stat-value">${s.total}</div>
        <div class="stat-sub">${s.disponible} disponibles · ${s.livre} livrées</div>
      </div>`;
    Object.keys(OPS).forEach(op => {
      const row = s.parOperateur.find(r=>r.operateur===op)||{total:0,disponible:0,livre:0};
      html += `
        <div class="stat-card" style="--op-color:${OPS[op].color}">
          <div class="stat-label">${op}</div>
          <div class="stat-value" style="color:${OPS[op].color}">${row.disponible||0}</div>
          <div class="stat-sub">${row.total||0} total · ${row.livre||0} livrées</div>
        </div>`;
    });
    html += `
      <div class="stat-card" style="--op-color:#7c3aed">
        <div class="stat-label">Livraisons</div>
        <div class="stat-value" style="color:#7c3aed">${s.livraisons}</div>
        <div class="stat-sub">bordereaux générés</div>
      </div>
      <div class="stat-card" style="--op-color:#f59e0b">
        <div class="stat-label">Clients</div>
        <div class="stat-value" style="color:#f59e0b">${s.clients}</div>
        <div class="stat-sub">clients actifs</div>
      </div>`;
    grid.innerHTML = html;
    const sims = await api('/api/sims?limit=10').then(r=>r.json());
    const tbody = document.getElementById('recent-table');
    tbody.innerHTML = sims.length
      ? sims.map(s=>`<tr><td class="iccid">${s.iccid}</td><td>${opBadge(s.operateur)}</td><td style="font-size:.77rem;color:var(--text-muted)">${s.lot}</td><td style="font-size:.77rem;color:var(--text-muted)">${fmtDate(s.date_entree)}</td><td>${statusBadge(s.status)}</td></tr>`).join('')
      : emptyRow(5,'Aucune puce','Ajoutez des puces dans le stock');
  } catch(e) { showToast('Erreur chargement dashboard','error'); }
}

// ── STOCK ────────────────────────────────────────────
async function loadStock() {
  const op=currentFilter, search=document.getElementById('search-iccid')?.value||'';
  const tbody=document.getElementById('stock-table');
  tbody.innerHTML=loadingRow(6);
  try {
    let url='/api/sims?limit=200';
    if (op) url+=`&operateur=${encodeURIComponent(op)}`;
    if (search) url+=`&search=${encodeURIComponent(search)}`;
    const sims=await api(url).then(r=>r.json());
    tbody.innerHTML=sims.length
      ? sims.map((s,i)=>`<tr><td style="color:var(--text-muted);font-size:.72rem">${i+1}</td><td class="iccid">${s.iccid}</td><td>${opBadge(s.operateur)}</td><td style="font-size:.78rem;color:var(--text-muted)">${s.lot}</td><td style="font-size:.78rem;color:var(--text-muted)">${fmtDate(s.date_entree)}</td><td>${statusBadge(s.status)}</td></tr>`).join('')
      : emptyRow(6,'Aucun résultat','Essayez un autre filtre');
  } catch(e) { tbody.innerHTML=emptyRow(6,'Erreur',e.message); }
}

function filterStock(op, btn) {
  currentFilter=op;
  document.querySelectorAll('#filter-tabs .tab-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active'); loadStock();
}

async function addLot() {
  const op=document.getElementById('add-op').value;
  const lot=document.getElementById('add-lot').value.trim();
  const iccids=document.getElementById('add-iccids').value.trim().split('\n').map(l=>l.trim()).filter(Boolean);
  if (!op) return showToast('Choisissez un opérateur','error');
  if (!lot) return showToast('Entrez un nom de lot','error');
  if (!iccids.length) return showToast('Entrez au moins un ICCID','error');
  const btn=document.getElementById('btn-add-lot'); btn.disabled=true; btn.innerHTML='<div class="loader"></div> …';
  try {
    const r=await api('/api/sims/lot',{method:'POST',body:JSON.stringify({operateur:op,lot,iccids})}).then(r=>r.json());
    if (r.error) throw new Error(r.error);
    showToast('✅ ' + r.added + ' ajoutée(s)' + (r.skipped?' · '+r.skipped+' doublon(s)':''), 'success');
    clearAddForm(); loadStock();
  } catch(e) { showToast('Erreur : '+e.message,'error'); }
  finally { btn.disabled=false; btn.innerHTML='💾 Enregistrer le lot'; }
}

function clearAddForm() {
  document.getElementById('add-op').value=''; document.getElementById('add-lot').value='';
  document.getElementById('add-iccids').value=''; document.getElementById('iccid-count').textContent='0 puce(s)';
}

// ── CLIENTS ──────────────────────────────────────────
async function loadClients() {
  try {
    allClients = await api('/api/clients').then(r=>r.json());
    renderClientsTable();
    populateClientSelects();
    populateHistTabs();
  } catch(e) { console.error('Erreur clients', e); }
}

function renderClientsTable() {
  const tbody = document.getElementById('clients-table');
  if (!tbody) return;
  tbody.innerHTML = allClients.length
    ? allClients.map(c=>`<tr>
        <td style="font-weight:600">${c.nom}</td>
        <td style="font-size:.79rem;color:var(--text-muted);max-width:200px">${c.adresse||'—'}</td>
        <td><span class="active-badge ${c.is_active?'on':'off'}">${c.is_active?'● Actif':'● Désactivé'}</span></td>
        <td><button class="btn btn-secondary btn-sm" onclick="viewFicheClient(${c.id})">📋 Fiche</button></td>
        <td style="font-size:.77rem;color:var(--text-muted)">${c.created_by||'—'}</td>
        <td class="flex gap-2">
          <button class="btn btn-warn btn-sm" onclick="openClientModal(${c.id})">✏️</button>
          <button class="btn btn-danger btn-sm" onclick="deleteClient(${c.id},'${c.nom.replace(/'/g,"\\'")}')">🗑️</button>
        </td></tr>`)
      .join('')
    : emptyRow(6,'Aucun client','Créez votre premier client');
}

function populateClientSelects() {
  const sel = document.getElementById('liv-client-id');
  if (!sel) return;
  const current = sel.value;
  sel.innerHTML = '<option value="">-- Choisir un client --</option>' +
    allClients.filter(c=>c.is_active).map(c=>`<option value="${c.id}">${c.nom}</option>`).join('');
  if (current) sel.value = current;
}

function populateHistTabs() {
  const tabs = document.getElementById('hist-tabs');
  if (!tabs) return;
  tabs.innerHTML = '<button class="tab-btn active" onclick="filterHistorique(null,this)">Tous</button>' +
    allClients.filter(c=>c.is_active).map(c=>`<button class="tab-btn" onclick="filterHistorique(${c.id},this)">${c.nom}</button>`).join('');
}

function onClientChange() {
  const id = document.getElementById('liv-client-id').value;
  const client = allClients.find(c=>c.id==id);
  const addrGroup = document.getElementById('liv-adresse-group');
  if (client?.adresse) {
    addrGroup.style.display = '';
    document.getElementById('liv-adresse-display').value = client.adresse;
  } else {
    addrGroup.style.display = 'none';
  }
}

function openClientModal(id=null) {
  editingClientId = id;
  const c = id ? allClients.find(x=>x.id===id) : null;
  document.getElementById('client-modal-title').textContent = c ? 'Modifier le client' : 'Nouveau client';
  document.getElementById('cm-nom').value = c?.nom || '';
  document.getElementById('cm-nom').readOnly = !!c;
  document.getElementById('cm-adresse').value = c?.adresse || '';
  document.getElementById('cm-active-group').style.display = c ? '' : 'none';
  if (c) document.getElementById('cm-active').value = c.is_active ? 'true' : 'false';
  document.getElementById('client-modal').classList.add('open');
}

function closeClientModal() { document.getElementById('client-modal').classList.remove('open'); editingClientId=null; }

async function saveClient() {
  const nom = document.getElementById('cm-nom').value.trim();
  const adresse = document.getElementById('cm-adresse').value.trim();
  const is_active = document.getElementById('cm-active').value === 'true';
  if (!nom) return showToast('Le nom est requis','error');
  const btn = document.getElementById('btn-save-client'); btn.disabled=true; btn.innerHTML='<div class="loader"></div>';
  try {
    let r;
    if (editingClientId) {
      r = await api('/api/clients/'+editingClientId, {method:'PUT', body:JSON.stringify({adresse:adresse||null, is_active})}).then(r=>r.json());
    } else {
      r = await api('/api/clients', {method:'POST', body:JSON.stringify({nom, adresse:adresse||null})}).then(r=>r.json());
    }
    if (r.error) throw new Error(r.error);
    showToast(editingClientId ? '✅ Client modifié' : '✅ Client créé', 'success');
    closeClientModal(); await loadClients();
  } catch(e) { showToast('Erreur : '+e.message,'error'); }
  finally { btn.disabled=false; btn.innerHTML='💾 Enregistrer'; }
}

async function deleteClient(id, nom) {
  if (!confirm('Supprimer le client "'+nom+'" ?')) return;
  try {
    const r = await api('/api/clients/'+id, {method:'DELETE'}).then(r=>r.json());
    if (r.error) throw new Error(r.error);
    showToast('Client supprimé','info'); await loadClients();
  } catch(e) { showToast('Erreur : '+e.message,'error'); }
}

async function viewFicheClient(id) {
  try {
    const c = await api('/api/clients/'+id).then(r=>r.json());
    document.getElementById('fiche-title').textContent = '📋 ' + c.nom;
    const livs = c.livraisons || [];
    document.getElementById('fiche-content').innerHTML = `
      <div class="form-group mb-4">
        <label>Adresse</label>
        <div style="padding:10px 0;color:var(--text)">${c.adresse||'—'}</div>
      </div>
      <div style="font-weight:700;font-size:.88rem;margin-bottom:12px;">Livraisons (${livs.length})</div>
      ${livs.length ? livs.map(l=>`
        <div class="fiche-livraison">
          <div>
            <div class="fiche-livraison-ref">${l.ref}</div>
            <div class="fiche-livraison-info">${opBadge(l.operateur)} · ${l.quantite} puces · ${fmtDate(l.date_livraison)}</div>
          </div>
          <button class="btn btn-success btn-sm" onclick="viewBordereau('${l.ref}')">🖨️</button>
        </div>`).join('')
      : '<div class="text-muted" style="padding:12px 0">Aucune livraison pour ce client.</div>'}`;
    document.getElementById('fiche-modal').classList.add('open');
  } catch(e) { showToast('Erreur','error'); }
}

// ── LIVRAISON ────────────────────────────────────────
function initLivraison() {
  document.getElementById('liv-date').value = new Date().toISOString().slice(0,10);
  document.getElementById('liv-ref').value  = 'BL-' + Date.now().toString().slice(-7);
  document.getElementById('sim-select-card').style.display = 'none';
  document.getElementById('liv-adresse-group').style.display = 'none';
  selectedIds = [];
  populateClientSelects();
}

async function loadAvailableSims() {
  const op = document.getElementById('liv-op').value;
  const card = document.getElementById('sim-select-card');
  const chips = document.getElementById('sim-chips');
  selectedIds = [];
  if (!op) { card.style.display='none'; return; }
  document.getElementById('op-label-sel').textContent = op;
  card.style.display = 'block';
  chips.innerHTML = '<div class="text-muted" style="padding:8px;display:flex;align-items:center;gap:8px"><div class="loader"></div> Chargement…</div>';
  try {
    const sims = await api('/api/sims?operateur='+encodeURIComponent(op)+'&status=disponible&limit=500').then(r=>r.json());
    chips.innerHTML = sims.length
      ? sims.map(s=>'<div class="chip-item" data-id="'+s.iccid+'" onclick="toggleSim(this,\''+s.iccid+'\')"><span class="chip-check">✓</span>'+s.iccid+'</div>').join('')
      : '<div class="text-muted" style="padding:10px">Aucune puce disponible.</div>';
  } catch { chips.innerHTML='<div class="text-muted" style="padding:10px">Erreur.</div>'; }
  updateSelCount();
}

function toggleSim(el,id) { el.classList.toggle('selected'); el.classList.contains('selected')?selectedIds.push(id):selectedIds=selectedIds.filter(x=>x!==id); updateSelCount(); }
function selectAll() { document.querySelectorAll('#sim-chips .chip-item').forEach(el=>{el.classList.add('selected');if(!selectedIds.includes(el.dataset.id))selectedIds.push(el.dataset.id);}); updateSelCount(); }
function deselectAll() { document.querySelectorAll('#sim-chips .chip-item').forEach(el=>el.classList.remove('selected')); selectedIds=[]; updateSelCount(); }
function updateSelCount() { document.getElementById('sel-count').textContent=selectedIds.length+' sélectionnée(s)'; }

async function genererBordereau() {
  const clientId  = document.getElementById('liv-client-id').value;
  const op        = document.getElementById('liv-op').value;
  const date      = document.getElementById('liv-date').value;
  const ref       = document.getElementById('liv-ref').value;
  const client    = allClients.find(c=>c.id==clientId);
  if (!clientId)        return showToast('Choisissez un client','error');
  if (!op)              return showToast("Choisissez l'opérateur",'error');
  if (!selectedIds.length) return showToast('Sélectionnez au moins une puce','error');
  const btn=document.getElementById('btn-gen'); btn.disabled=true; btn.innerHTML='<div class="loader"></div> …';
  try {
    const r = await api('/api/livraisons',{method:'POST',body:JSON.stringify({
      ref, client_id:parseInt(clientId), client_nom:client.nom, operateur:op, date_livraison:date, iccids:selectedIds
    })}).then(r=>r.json());
    if (r.error) throw new Error(r.error);
    const liv = await api('/api/livraisons/'+ref).then(r=>r.json());
    renderBordereau(liv);
    showToast('✅ Bordereau généré !','success');
    resetLivraison();
  } catch(e) { showToast('Erreur : '+e.message,'error'); }
  finally { btn.disabled=false; btn.innerHTML='🖨️ Générer le bordereau'; }
}

function resetLivraison() {
  document.getElementById('liv-client-id').value='';
  document.getElementById('liv-op').value='';
  document.getElementById('liv-adresse-group').style.display='none';
  selectedIds=[];
  initLivraison();
}

// ── HISTORIQUE ───────────────────────────────────────
function filterHistorique(clientId, btn) {
  histClientFilter = clientId;
  document.querySelectorAll('#hist-tabs .tab-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  loadHistorique();
}

async function loadHistorique() {
  const tbody = document.getElementById('hist-table');
  const search = document.getElementById('search-hist')?.value.toLowerCase()||'';
  tbody.innerHTML = loadingRow(8);
  try {
    let url = '/api/livraisons';
    if (histClientFilter) url += '?client_id='+histClientFilter;
    const livs = await api(url).then(r=>r.json());
    const filtered = search ? livs.filter(l=>l.client_nom.toLowerCase().includes(search)||l.ref.toLowerCase().includes(search)) : livs;
    const canDel = can('*');
    tbody.innerHTML = filtered.length
      ? filtered.map(l=>`<tr>
          <td style="font-family:'Space Mono',monospace;font-size:.76rem;color:var(--accent)">${l.ref}</td>
          <td style="font-weight:600">${l.client_nom}</td>
          <td style="font-size:.78rem;color:var(--text-muted);max-width:160px">${l.client_adresse||'—'}</td>
          <td>${opBadge(l.operateur)}</td>
          <td style="font-family:'Space Mono',monospace;font-weight:700">${l.quantite}</td>
          <td style="color:var(--text-muted);font-size:.81rem">${fmtDate(l.date_livraison)}</td>
          <td style="font-size:.77rem;color:var(--text-muted)">${l.created_by||'—'}</td>
          <td class="flex gap-2">
            <button class="btn btn-success btn-sm" onclick="viewBordereau('${l.ref}')">🖨️</button>
            ${canDel?'<button class="btn btn-danger btn-sm" onclick="deleteLivraison(\''+l.ref+'\')">🗑️</button>':''}
          </td></tr>`)
        .join('')
      : emptyRow(8,'Aucune livraison','Créez votre première livraison');
  } catch(e) { tbody.innerHTML=emptyRow(8,'Erreur',e.message); }
}

async function viewBordereau(ref) {
  try { const liv=await api('/api/livraisons/'+ref).then(r=>r.json()); renderBordereau(liv); }
  catch(e) { showToast('Erreur : '+e.message,'error'); }
}

async function deleteLivraison(ref) {
  if (!confirm('Supprimer '+ref+' ? Les puces seront remises en stock.')) return;
  try {
    const r=await api('/api/livraisons/'+ref,{method:'DELETE'}).then(r=>r.json());
    if (r.error) throw new Error(r.error);
    showToast('Livraison supprimée','info'); loadHistorique();
  } catch(e) { showToast('Erreur : '+e.message,'error'); }
}

// ── USERS ────────────────────────────────────────────
async function loadUsers() {
  const tbody = document.getElementById('users-table');
  if (!tbody) return;
  tbody.innerHTML = loadingRow(6);
  try {
    const users = await api('/api/auth/users').then(r=>r.json());
    window._usersMap = {};
    users.forEach(u => window._usersMap[u.id] = u);
    const roleLabels = {admin:'Admin',stock:'Stock',livraison:'Livraison',consultation:'Consultation'};
    tbody.innerHTML = users.map(u=>`<tr>
      <td style="font-family:'Space Mono',monospace;font-size:.81rem">${u.username}</td>
      <td style="font-weight:600">${u.full_name}</td>
      <td><span class="user-role role-${u.role}">${roleLabels[u.role]||u.role}</span></td>
      <td><span class="active-badge ${u.is_active?'on':'off'}">${u.is_active?'● Actif':'● Désactivé'}</span></td>
      <td style="color:var(--text-muted);font-size:.78rem">${u.last_login?fmtDate(u.last_login):'Jamais'}</td>
      <td class="flex gap-2">
        <button class="btn btn-warn btn-sm" onclick="openUserModal(window._usersMap[${u.id}])">✏️</button>
        ${u.id!==currentUser.id?'<button class="btn btn-danger btn-sm" onclick="deleteUser('+u.id+',\''+u.username+'\')">🗑️</button>':'<span class="text-muted" style="font-size:.71rem">Vous</span>'}
      </td></tr>`).join('');
  } catch(e) { tbody.innerHTML=emptyRow(6,'Erreur',e.message); }
}

function openUserModal(user=null) {
  editingUserId = user ? user.id : null;
  document.getElementById('user-modal-title').textContent = user ? 'Modifier l\'utilisateur' : 'Nouvel utilisateur';
  document.getElementById('um-username').value = user?.username||'';
  document.getElementById('um-username').readOnly = !!user;
  document.getElementById('um-fullname').value = user?.full_name||'';
  document.getElementById('um-role').value = user?.role||'consultation';
  document.getElementById('um-password').value = '';
  document.getElementById('um-pass-hint').textContent = user ? '(laisser vide = inchangé)' : '';
  document.getElementById('um-active-group').style.display = user ? '' : 'none';
  if (user) document.getElementById('um-active').value = user.is_active ? 'true' : 'false';
  document.getElementById('user-modal').classList.add('open');
}

function closeUserModal() { document.getElementById('user-modal').classList.remove('open'); editingUserId=null; }

async function saveUser() {
  const username  = document.getElementById('um-username').value.trim();
  const full_name = document.getElementById('um-fullname').value.trim();
  const role      = document.getElementById('um-role').value;
  const password  = document.getElementById('um-password').value;
  const is_active = document.getElementById('um-active').value === 'true';
  if (!username||!full_name||!role) return showToast('Remplissez tous les champs','error');
  if (!editingUserId && !password)  return showToast('Mot de passe requis','error');
  const btn=document.getElementById('btn-save-user'); btn.disabled=true; btn.innerHTML='<div class="loader"></div>';
  try {
    let r;
    if (editingUserId) {
      const body={full_name,role,is_active}; if(password) body.password=password;
      r=await api('/api/auth/users/'+editingUserId,{method:'PUT',body:JSON.stringify(body)}).then(r=>r.json());
    } else {
      r=await api('/api/auth/users',{method:'POST',body:JSON.stringify({username,password,full_name,role})}).then(r=>r.json());
    }
    if (r.error) throw new Error(r.error);
    showToast(editingUserId?'✅ Utilisateur modifié':'✅ Utilisateur créé','success');
    closeUserModal(); loadUsers();
  } catch(e) { showToast('Erreur : '+e.message,'error'); }
  finally { btn.disabled=false; btn.innerHTML='💾 Enregistrer'; }
}

async function deleteUser(id, username) {
  if (!confirm('Supprimer "'+username+'" ?')) return;
  try {
    const r=await api('/api/auth/users/'+id,{method:'DELETE'}).then(r=>r.json());
    if (r.error) throw new Error(r.error);
    showToast('Utilisateur supprimé','info'); loadUsers();
  } catch(e) { showToast('Erreur : '+e.message,'error'); }
}

// ── BORDEREAU ────────────────────────────────────────
function renderBordereau(liv) {
  const op = OPS[liv.operateur]||{color:'#333',emoji:'📱'};
  const sims = liv.sims||[];
  document.getElementById('bdr-content').innerHTML = `
    <div class="bdr-header">
      <div><div class="bdr-title">BORDEREAU DE LIVRAISON</div><div class="bdr-subtitle">Cartes SIM — ${liv.operateur}</div></div>
      <div class="bdr-ref">Édité le ${new Date().toLocaleDateString('fr-FR')}<strong>${liv.ref}</strong></div>
    </div>
    <div class="bdr-op" style="background:${op.color}18;border:2px solid ${op.color}40;color:${op.color}">
      ${op.emoji} &nbsp;<strong>Opérateur :</strong> &nbsp;${liv.operateur}
    </div>
    <div class="bdr-info">
      <div><div class="bdr-info-label">Client</div><div class="bdr-info-value">${liv.client_nom}</div></div>
      <div><div class="bdr-info-label">Date</div><div class="bdr-info-value">${fmtDate(liv.date_livraison)}</div></div>
      ${liv.client_adresse?'<div class="full"><div class="bdr-info-label">Adresse</div><div class="bdr-info-value" style="font-size:.85rem">'+liv.client_adresse+'</div></div>':''}
      <div><div class="bdr-info-label">Référence</div><div class="bdr-info-value" style="font-family:monospace">${liv.ref}</div></div>
      <div><div class="bdr-info-label">Quantité</div><div class="bdr-info-value">${liv.quantite} puce(s)</div></div>
    </div>
    <table class="bdr-table">
      <thead><tr><th>#</th><th>ICCID</th><th>Opérateur</th><th>Statut</th></tr></thead>
      <tbody>${sims.map((ic,i)=>'<tr><td>'+(i+1)+'</td><td>'+ic+'</td><td>'+liv.operateur+'</td><td>Livré</td></tr>').join('')}</tbody>
    </table>
    <div class="bdr-summary"><div class="bdr-summary-box"><div class="bdr-summary-label">Total livré</div><div class="bdr-summary-value">${liv.quantite}</div></div></div>
    <div class="bdr-sigs">
      <div><div class="sig-label">Signature du livreur</div><div class="sig-line"></div></div>
      <div><div class="sig-label">Signature du client</div><div class="sig-line"></div></div>
    </div>`;
  document.getElementById('bdr-modal').classList.add('open');
}

// ── UTILS ────────────────────────────────────────────
function opBadge(op){const c=op==='Ooredoo'?'ooredoo':op==='Tunisie Telecom'?'tunisie':'orange';return '<span class="op-badge '+c+'"><span class="op-dot"></span>'+op+'</span>';}
function statusBadge(s){return s==='disponible'?'<span class="status disponible">● Disponible</span>':'<span class="status livre">● Livré</span>';}
function emptyRow(cols,title,sub){return '<tr><td colspan="'+cols+'"><div class="empty-state"><div class="empty-state-icon">📦</div><h3>'+title+'</h3><p>'+sub+'</p></div></td></tr>';}
function loadingRow(cols){return '<tr><td colspan="'+cols+'" style="text-align:center;padding:30px"><div class="loader" style="margin:auto"></div></td></tr>';}
function fmtDate(d){if(!d)return'—';return new Date(d).toLocaleDateString('fr-FR');}
function showToast(msg,type='info'){const t=document.getElementById('toast');t.textContent=msg;t.className='toast show '+type;setTimeout(()=>t.classList.remove('show'),3500);}

// ── INIT ─────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', async () => {
  const ok = await tryAutoLogin();
  if (ok) initApp();
  else document.getElementById('login-screen').style.display = 'flex';

  document.getElementById('add-iccids')?.addEventListener('input', function(){
    document.getElementById('iccid-count').textContent = this.value.split('\n').filter(l=>l.trim()).length + ' puce(s)';
  });
});
</script>
</body>
</html>
